---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Search from "@/components/Search.astro";
import Newsletter from "@/components/Newsletter.astro";
import { company } from "@/config/company";
import { getCollection } from "astro:content";
import { getReadingTime } from "@/utils/reading-time";

const POSTS_PER_PAGE = 5;

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

// Pre-compute search data in frontmatter to avoid esbuild backtick parsing issues
const codeBlockRe = /`{3}[\s\S]*?`{3}/g;
const markdownRe = /[#*`>\-|_\[\](){}]/g;
const searchData = JSON.stringify(
  posts.map(post => ({
    title: post.data.title,
    desc: post.data.description || "",
    body: (post.body || "").replace(codeBlockRe, "").replace(markdownRe, " ").replace(/\s+/g, " ").trim(),
    href: "/blog/" + post.id + "/",
    tags: post.data.tags || [],
  }))
);
---

<BaseLayout
  title="Blog"
  description={`Engineering notes by ${company.founder.name} on Go, backend systems, databases and tooling.`}
  width="narrow"
>
  <header class="blog-header">
    <h1 class="article-title">Blog</h1>
    <p class="blog-intro">
      Engineering notes by {company.founder.name}, {company.founder.role} of {company.name}.
    </p>
  </header>

  <!-- Search data for full-content search -->
  <script id="search-data" type="application/json" set:html={searchData} />

  <h2 class="section-heading">All Posts</h2>
  <Search />
  <ul class="post-list" id="post-list">
    {posts.map((post) => (
      <li class="post-item">
        <a href={`/blog/${post.id}/`} class="post-title-link">
          {post.data.title}
        </a>
        {post.data.description && (
          <p class="post-excerpt">{post.data.description}</p>
        )}
        <div class="post-meta">
          {post.data.tags && post.data.tags.map((tag: string) => (
            <a href={`/blog/tags/${tag}/`} class="tag-pill">{tag}</a>
          ))}
          <time class="post-date" datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          {post.body && (
            <span class="reading-time">&middot; {getReadingTime(post.body)}</span>
          )}
        </div>
      </li>
    ))}
  </ul>

  <!-- Pagination -->
  {posts.length > POSTS_PER_PAGE && (
    <nav class="pagination" id="pagination">
      <button id="prev-btn" class="pagination-btn" disabled>&larr; Previous</button>
      <span id="page-indicator" class="pagination-info">Page 1</span>
      <button id="next-btn" class="pagination-btn">Next &rarr;</button>
    </nav>
  )}

  <script is:inline define:vars={{ POSTS_PER_PAGE }}>
    document.addEventListener("astro:page-load", () => {
      const list = document.getElementById("post-list");
      if (!list) return;
      const items = Array.from(list.querySelectorAll(".post-item"));
      const total = items.length;
      const perPage = POSTS_PER_PAGE;
      if (total <= perPage) return;

      const totalPages = Math.ceil(total / perPage);
      const storageKey = "pagination-blog-page";
      let page = parseInt(sessionStorage.getItem(storageKey) || "1", 10);
      if (page < 1 || page > totalPages) page = 1;

      const prev = document.getElementById("prev-btn");
      const next = document.getElementById("next-btn");
      const indicator = document.getElementById("page-indicator");

      function render() {
        const nav = document.getElementById("pagination");
        let prevNavTop = 0;
        if (nav) {
          prevNavTop = nav.getBoundingClientRect().top;
        }

        const start = (page - 1) * perPage;
        const end = start + perPage;
        items.forEach((item, i) => {
          item.style.display = (i >= start && i < end) ? "" : "none";
        });
        
        // Restore scroll position so the pagination buttons stay directly beneath the cursor
        if (nav) {
          const newNavTop = nav.getBoundingClientRect().top;
          window.scrollBy(0, newNavTop - prevNavTop);
        }

        if (prev) prev.disabled = page <= 1;
        if (next) next.disabled = page >= totalPages;
        if (indicator) indicator.textContent = `Page ${page} of ${totalPages}`;
        sessionStorage.setItem(storageKey, page.toString());
      }

      render();

      if (prev) {
        prev.onclick = () => { if (page > 1) { page--; render(); } };
      }
      if (next) {
        next.onclick = () => { if (page < totalPages) { page++; render(); } };
      }
    });
  </script>

  <Newsletter />
</BaseLayout>
