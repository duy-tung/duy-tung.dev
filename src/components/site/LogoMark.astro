---
/**
 * Placeholder brand mark: three rising "rungs".
 * TODO: replace with the real Rungwise logo when one exists (also update
 * public/favicon.svg and re-run `pnpm icons`).
 */
interface Props {
  size?: number;
}

const { size = 24 } = Astro.props;
---

<svg
  class="logo-mark"
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
>
  <rect width="32" height="32" rx="8" fill="var(--color-accent)"></rect>
  <rect x="7" y="20" width="9" height="4" rx="2" fill="#fff"></rect>
  <rect x="11.5" y="14" width="9" height="4" rx="2" fill="#fff" opacity="0.85"></rect>
  <rect x="16" y="8" width="9" height="4" rx="2" fill="#fff" opacity="0.7"></rect>
</svg>
