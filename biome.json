{
    "$schema": "https://biomejs.dev/schemas/2.0.6/schema.json",
    "assist": {
        "actions": {
            "source": {
                "organizeImports": {
                    "level": "on"
                }
            }
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true
        }
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 2,
        "lineWidth": 100
    },
    "files": {
        "includes": [
            "src/**",
            "*.mjs",
            "*.ts",
            "*.json"
        ],
        "excludes": [
            "dist/**",
            ".astro/**",
            "node_modules/**"
        ]
    }
}