---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BuiltWithClaude from "@/components/site/BuiltWithClaude.astro";
import FeatureGrid from "@/components/site/FeatureGrid.astro";
import HowItWorks from "@/components/site/HowItWorks.astro";
import ProductCta from "@/components/site/ProductCta.astro";
import Todo from "@/components/site/Todo.astro";
import { company } from "@/config/company";
import { getCollection } from "astro:content";

const latestPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero">
    <p class="eyebrow">{company.industry} &middot; {company.location.city}</p>
    <h1 class="hero-title">{company.pitch ?? company.name}</h1>
    {!company.pitch && <Todo label="One-line pitch for the hero headline (company.pitch)" />}
    <ProductCta />
  </section>

  <!-- Problem -->
  <section class="section" aria-labelledby="problem-heading">
    <div class="split">
      <div>
        <p class="eyebrow">The problem</p>
        <h2 id="problem-heading" class="section-title">What we're solving</h2>
      </div>
      <div>
        {company.problem ? (
          <p class="section-lead">{company.problem}</p>
        ) : (
          <Todo label="The problem we solve (company.problem)" />
        )}
        {company.audience ? (
          <p class="section-lead"><strong>Who it's for:</strong> {company.audience}</p>
        ) : (
          <Todo label="Who we solve it for (company.audience)" />
        )}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section" aria-labelledby="how-heading">
    <p class="eyebrow">How it works</p>
    <h2 id="how-heading" class="section-title">From start to finish</h2>
    <HowItWorks />
  </section>

  <!-- Features -->
  <section class="section" aria-labelledby="features-heading">
    <p class="eyebrow">Features</p>
    <h2 id="features-heading" class="section-title">What {company.product.name ?? "the product"} does</h2>
    <FeatureGrid />
  </section>

  <!-- Built with Claude -->
  <section class="section">
    <BuiltWithClaude />
  </section>

  <!-- From the blog (real posts only) -->
  {latestPosts.length > 0 && (
    <section class="section" aria-labelledby="blog-heading">
      <div class="section-header-row">
        <div>
          <p class="eyebrow">Blog</p>
          <h2 id="blog-heading" class="section-title">Latest writing</h2>
        </div>
        <a href="/blog/" class="text-link">All posts <span aria-hidden="true">&rarr;</span></a>
      </div>
      <ul class="card-grid">
        {latestPosts.map((post) => (
          <li class="card card-link">
            <time class="card-meta" datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
            <h3 class="card-title">
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h3>
            {post.data.description && <p class="card-text">{post.data.description}</p>}
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Closing CTA -->
  <section class="section cta-band">
    <h2 class="section-title">Talk to {company.founder.name}</h2>
    <p class="section-lead">
      Questions, feedback or partnership ideas: get in touch with the founder directly.
    </p>
    <div class="cta-row">
      <a href="/contact/" class="btn btn-primary">Contact us <span aria-hidden="true">&rarr;</span></a>
    </div>
  </section>
</BaseLayout>
