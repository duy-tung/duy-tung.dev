---
interface Props {
  heading?: string;
  description?: string;
}

const {
  heading = "Stay updated",
  description = "Subscribe via RSS to get notified when I publish something new.",
} = Astro.props;
---

<section class="newsletter" aria-label="Subscribe">
  <div class="newsletter-content">
    <div class="newsletter-text">
      <h3 class="newsletter-heading">{heading}</h3>
      <p class="newsletter-description">{description}</p>
    </div>
    <a href="/rss.xml" target="_blank" class="newsletter-btn" aria-label="Subscribe via RSS">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <circle cx="6.18" cy="17.82" r="2.18" />
        <path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z" />
      </svg>
      Subscribe via RSS
    </a>
  </div>
</section>
